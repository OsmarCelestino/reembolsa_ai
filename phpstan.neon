# Análise estática com Larastan (PHPStan com regras do Laravel).
#   docker compose exec app composer analyse   (o padrão de 128 MB do PHP não é suficiente)
includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - app
        - config
        - database
        - routes

    # Lê os casts declarados no método casts() (padrão do Laravel 11+).
    parseModelCastsMethod: true
